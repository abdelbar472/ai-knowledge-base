              "  pm.expect(j.answer).to.be.a('string').and.not.empty;",
              "  pm.expect(j.sources.length).to.be.greaterThan(0);",
              "});",
              "console.log('A:', pm.response.json().answer);",
              "console.log('sources:', JSON.stringify(pm.response.json().sources, null, 2));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4f. /ask - unknown capability (repeat for each of COBOL, ALGOL, Ada...)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Is Ada in his stack?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/ask",
          "host": ["{{baseUrl}}"],
          "path": ["ask"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200 + No\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().answer).to.match(/No/); });",
              "pm.test(\"gate skips LLM -> empty sources\", function () { pm.expect(pm.response.json().sources).to.eql([]); });",
              "// 2nd run of THIS request is served from the local SQLite cache (\"Local QA cache hit\") without re-running the gate.",
              "console.log('A:', pm.response.json().answer);"
            ],
            "type": "text/javascript"
          }
